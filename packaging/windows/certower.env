# Certower server settings.
# After a change: Restart-Service Certower
# All settings: certower serve -h, or docs/admin-guide.md.

CERTOWER_DB=sqlite:C:/ProgramData/Certower/certower.db
# PostgreSQL instead:
#CERTOWER_DB=postgres://certower:PASSWORD@localhost:5432/certower?sslmode=disable

# Encrypts stored private keys and credentials. BACK IT UP.
CERTOWER_KEK_FILE=C:/ProgramData/Certower/certower.kek

# A Windows service has no console, so logs go here.
CERTOWER_LOG_FILE=C:/ProgramData/Certower/certower.log

CERTOWER_LISTEN=:8080
CERTOWER_AGENT_LISTEN=:8443

# Address agents use to reach the agent API, shown in enrollment commands.
#CERTOWER_AGENT_URL=https://certower.example.com:8443

# The web UI's public address: used in notification links and for SSO.
#CERTOWER_PUBLIC_URL=https://certower.example.com
#CERTOWER_SECURE_COOKIES=true
#CERTOWER_TRUSTED_PROXIES=127.0.0.1

# Single sign-on (see docs/authentication.md).
#CERTOWER_OIDC_ISSUER=https://login.microsoftonline.com/TENANT-ID/v2.0
#CERTOWER_OIDC_CLIENT_ID=
#CERTOWER_OIDC_CLIENT_SECRET=
#CERTOWER_OIDC_NAME=Entra ID
